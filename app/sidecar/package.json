{
  "name": "replay-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": "./dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --packages=external && node ./scripts/wrap-cjs-shim.mjs",
    "pack": "node ./scripts/pack.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "better-sqlite3": "^11.10.0",
    "openai": "^4.77.0",
    "sharp": "^0.34.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
