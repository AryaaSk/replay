<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for spawning screenpipe + replay-cli + claude/codex.
         Hardened Runtime blocks unsigned subprocess execution by default;
         this entitlement re-allows it for processes our app launches. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Outbound HTTPS for the Anthropic / OpenAI API calls + screenpipe install
         from the npm registry + Sparkle update checks. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Screen Recording / Microphone / Accessibility are NOT bundle-level
         entitlements — macOS prompts the user via TCC at first use, then
         persists the grant to ~/Library/Application Support/com.apple.TCC/.
         No declaration needed here. -->

    <!-- Permission strings for the TCC prompts. macOS shows these to the
         user when the OS asks them to grant a sensitive permission. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Replay records microphone audio to transcribe narration during a recording.</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Replay records the screen to capture frames for the structured replay report.</string>
</dict>
</plist>
